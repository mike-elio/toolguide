# Ollama is only used when curated aliases cannot resolve a short-text answer.
OLLAMA_MODEL=gemma3:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=60

# Comma-separated origins allowed to call the API from a separate frontend.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
